<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>منو</title>
<style>
  body{margin:0;min-height:100vh;min-height:100dvh;display:grid;place-items:center;background:#1a0f0a;color:#fff;font-family:Tahoma,sans-serif;text-align:center;padding:20px}
  a{color:#ffd9b4;font-size:16px}
  .sp{width:34px;height:34px;margin:0 auto 14px;border:4px solid rgba(255,255,255,.2);border-top-color:#fe7b01;border-radius:50%;animation:r 1s linear infinite}
  @keyframes r{to{transform:rotate(360deg)}}
</style>
</head>
<body>
<div>
  <div class="sp" id="sp"></div>
  <p id="m">در حال اتصال به منو...</p>
  <div id="l"></div>
</div>
<script>
var SITES = ["https://menuc1.ir", "https://menu4.servervnp23.workers.dev"];
var TIMEOUT = 8000;

var done = false, left = SITES.length;
var suffix = location.search + location.hash;

function go(u) {
  if (done) return;
  done = true;
  location.replace(u + "/" + suffix);
}
function fail() {
  left--;
  if (left > 0 || done) return;
  document.getElementById("sp").style.display = "none";
  document.getElementById("m").textContent = "اتصال خودکار برقرار نشد؛ یکی از لینک‌ها را امتحان کن:";
  var box = document.getElementById("l");
  SITES.forEach(function (u) {
    var p = document.createElement("p"), a = document.createElement("a");
    a.href = u + "/" + suffix;
    a.textContent = u.replace("https://", "");
    p.appendChild(a);
    box.appendChild(p);
  });
}
SITES.forEach(function (u) {
  var c = new AbortController();
  var t = setTimeout(function () { c.abort(); }, TIMEOUT);
  fetch(u + "/ping?_t=" + Date.now(), { mode: "no-cors", cache: "no-store", signal: c.signal })
    .then(function () { clearTimeout(t); go(u); })
    .catch(function () { clearTimeout(t); fail(); });
});
</script>
</body>
</html>
